rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================================
    // FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E PAPÉIS
    // ============================================================================
    
    // Verifica se a requisição possui qualquer autenticação válida no Firebase
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se o usuário é um aluno conectado via autenticação anônima
    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    
    // Verifica se o usuário é o Professor / Administrador (autenticado por e-mail/senha ou credencial docente)
    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.firebase.sign_in_provider == 'password' ||
        request.auth.token.firebase.sign_in_provider != 'anonymous' ||
        request.auth.token.admin == true
      );
    }
    
    // Verifica se o usuário autenticado é o proprietário legítimo do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================================================
    // COLEÇÃO: ATENDIMENTOS REAIS (Modo Atendimento Real)
    // ============================================================================
    match /atendimentos_reais/{atendimentoId} {
      // LEITURA (read):
      // - Aluno anônimo só lê os seus próprios atendimentos (onde userId == auth.uid)
      // - Professor (admin) tem acesso de leitura a TODOS os atendimentos clínicos
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isTeacher()
      );
      
      // CRIAÇÃO (create):
      // - Aluno autenticado pode criar, desde que obrigatoriamente grave seu próprio uid no campo userId
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid;
      
      // EDIÇÃO (update):
      // - Aluno só pode editar o documento do qual é proprietário (sem poder transferir o userId)
      allow update: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid && 
                    request.resource.data.userId == request.auth.uid;
      
      // EXCLUSÃO (delete):
      // - Aluno dono do documento ou Professor docente
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isTeacher()
      );
    }

    // ============================================================================
    // COLEÇÃO: PRONTUÁRIOS E SUBMISSÕES ACADÊMICAS (Modo Simulação)
    // ============================================================================
    match /prontuarios/{prontuarioId} {
      // LEITURA (read):
      // - Aluno só lê suas próprias resoluções de casos
      // - Professor (admin) tem acesso de leitura irrestrito a todos os prontuários dos alunos
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isTeacher()
      );
      
      // CRIAÇÃO (create):
      // - Aluno grava seu próprio uid no campo userId
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid;
      
      // EDIÇÃO (update):
      // - Aluno proprietário pode atualizar o rascunho
      allow update: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid && 
                    request.resource.data.userId == request.auth.uid;
      
      // EXCLUSÃO (delete):
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isTeacher()
      );
    }

    // ============================================================================
    // COLEÇÃO: CASOS CLÍNICOS (Banco de Casos do Professor em Nuvem)
    // ============================================================================
    match /casos_clinicos/{casoId} {
      // LEITURA (read):
      // - Qualquer usuário (incluindo alunos sem login ou anônimos) pode ler os casos clínicos
      allow read: if true;
      
      // ESCRITA (write):
      // - Permite gravação pelo aplicativo
      allow write: if true;
    }

    // ============================================================================
    // COLEÇÃO: DISCIPLINAS (Disciplinas Acadêmicas em Nuvem)
    // ============================================================================
    match /disciplinas/{disciplinaId} {
      // LEITURA (read):
      // - Qualquer aluno pode consultar a lista de disciplinas
      allow read: if true;
      
      // ESCRITA (write):
      allow write: if true;
    }

    // ============================================================================
    // COLEÇÃO: PACIENTES VIRTUAIS (Perfis dos Pacientes Simulados em Nuvem)
    // ============================================================================
    match /pacientes_virtuais/{pacienteId} {
      // LEITURA (read):
      // - Alunos podem consultar o perfil do paciente simulado para anamnese e prontuário
      allow read: if true;
      
      // ESCRITA (write):
      allow write: if true;
    }

    // ============================================================================
    // COLEÇÃO: CONFIGURAÇÕES ACADÊMICAS (Módulos, Travas e Estado Geral)
    // ============================================================================
    match /configuracoes/{configDoc} {
      // LEITURA (read):
      // - Qualquer usuário (incluindo alunos anônimos e não autenticados) pode ler configurações e status de travas
      allow read: if true;
      
      // ESCRITA (write):
      allow write: if true;
    }

    // ============================================================================
    // COLEÇÃO: ALIMENTOS COLABORATIVOS (Tabela Global de Alimentos em Nuvem)
    // ============================================================================
    match /alimentos_colaborativos/{alimentoId} {
      // LEITURA (read):
      // - Qualquer usuário autenticado (incluindo alunos anônimos e professores) pode consultar os alimentos colaborativos
      allow read: if isAuthenticated();
      
      // CRIAÇÃO (create):
      // - Aluno ou professor autenticado pode cadastrar novo alimento com dados válidos
      allow create: if isAuthenticated() &&
                    request.resource.data.nome is string &&
                    request.resource.data.nome.size() > 0 &&
                    request.resource.data.kcal is number &&
                    request.resource.data.cho is number &&
                    request.resource.data.ptn is number &&
                    request.resource.data.lip is number;

      // EDIÇÃO / EXCLUSÃO (update / delete):
      // - Professor (admin) ou usuário que cadastrou o alimento
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isTeacher()
      );
    }
  }
}
